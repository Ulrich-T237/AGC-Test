# AGC ASSURANCES - EXEMPLE DE CONFIGURATION
# Copiez ce fichier vers .env puis adaptez les valeurs.
HOST=0.0.0.0
PORT=8000
# Open mode (v5.3) : l'application s'ouvre sans ecran de connexion.
# --- Mise en ligne (voir DEPLOY.md) ---
# Dossier de donnees (disque persistant, ex. /data sur Render).
# STORAGE_DIR=

# --- Cloud OCR (optional, v5.4.0): Gemini reads photos in seconds ---
# Get a free key at https://aistudio.google.com/apikey (never share it).
# Free quota is small (~20 reads/day on Flash models, Sept 2026 figures);
# when the quota is empty, the app automatically falls back to local OCR.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# OCR_MODE=local   # uncomment to force 100% local OCR (office privacy mode)
